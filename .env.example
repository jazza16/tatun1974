# FIRMS_MAP_KEY: NASA FIRMS (Fire Information for Resource Management System) MAP key for active wildfire / hotspot satellite tracking.
# Configure this key securely via the Secrets panel in AI Studio.
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY

# SUPABASE_URL & SUPABASE_KEY: Supabase project URL and publishable/anon key for citizen report photo storage.
# Configure these values securely via the Secrets panel in AI Studio.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# INTEGRITY_VERIFIER_URL: Optional HTTPS backend URL for Play Integrity Classic token verification (e.g. Cloud Function verifyIntegrityToken).
INTEGRITY_VERIFIER_URL=YOUR_INTEGRITY_VERIFIER_URL

# DOCUMENT_API_BASE_URL: Optional HTTPS BPBD Backend API base URL for remote PDF rendering (GET /reports/{id}/pdf), officer directory (GET /officers), and document settings (GET /document-settings).
# Configure this URL securely via the Secrets panel in AI Studio.
DOCUMENT_API_BASE_URL=YOUR_DOCUMENT_API_BASE_URL

