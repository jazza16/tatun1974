# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: GEMINI_API_KEY for direct Gemini AI API calls without Firebase App Check.
GEMINI_API_KEY=AIzaSyDHtqN6L3y4g9Ol9LGCjPVtKlC-Q_0lFl0

# FIRMS_MAP_KEY: NASA FIRMS (Fire Information for Resource Management System) MAP key for active wildfire / hotspot satellite tracking.
# Configure this key securely via the Secrets panel in AI Studio.
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY
