<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- KARTU 1: INFO PETUGAS (Dibuat Polos) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petugas Jaga:"
                    android:textSize="12sp"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvNamaPetugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HITATUN ARAZAK"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Tombol Tarik Data Sejajar dengan Badge Notifikasi Merah -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTarikLaporanWarga"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="DARI WARGA"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="8dp"/>

                        <TextView
                            android:id="@+id/tvBadgeDariWarga"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:minWidth="22dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-6dp"
                            android:layout_marginEnd="-4dp"
                            android:paddingHorizontal="6dp"
                            android:gravity="center"
                            android:elevation="6dp"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTarikLaporanKemarin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="UPDATE KEJADIAN"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        app:backgroundTint="#EF6C00"
                        app:cornerRadius="8dp"/>
                </LinearLayout>

                <!-- Preview Foto & Ringkasan Laporan Warga yang Digunakan -->
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/composeAttachedCitizenPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTU 2: FORMULIR UTAMA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informasi Dasar Kejadian"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp"/>

                <!-- Perbaikan Switch Kondusif -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchKondusif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="4dp"
                    android:text="Hari ini KONDUSIF (Tidak Ada Bencana)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />

                <!-- 1. Dropdown Jenis Bencana -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pilih Jenis Bencana"
                    app:boxStrokeColor="#1976D2"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/arrow_down_float"
                    android:layout_marginBottom="12dp">

                    <AutoCompleteTextView
                        android:id="@+id/dropdownJenisBencana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Tanggal & Waktu (Berdampingan) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:hint="Tanggal"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTanggalKejadian"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="6dp"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="#333333"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:hint="Waktu"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_recent_history">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaktuKejadian"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="6dp"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="#333333"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 3. Pilih Kecamatan (15 Kecamatan Mukomuko - Integrasi Cuaca Otomatis) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pilih Kecamatan (15 Kecamatan)"
                    app:boxStrokeColor="#1976D2"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/arrow_down_float"
                    android:layout_marginBottom="12dp">

                    <AutoCompleteTextView
                        android:id="@+id/dropdownKecamatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4. Detail Lokasi Bencana -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Detail Lokasi Bencana (Desa / Jalan)"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLokasiBencana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etKoordinat"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 5. Koordinat & Tombol GPS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Koordinat (Lintang, Bujur)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKoordinat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@+id/etKedalaman"
                            android:textColor="#333333"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAmbilGps"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:text="📍 GPS"
                        app:backgroundTint="#FF9800"
                        app:cornerRadius="8dp"/>
                </LinearLayout>

                <!-- 6. Kondisi Cuaca Terkini Kecamatan (Read-Only Otomatis dari Modul Cuaca) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kondisi Cuaca Kecamatan (Otomatis Read-Only)"
                    app:helperText="Diambil otomatis dari modul Info Cuaca 15 Kecamatan"
                    android:layout_marginBottom="12dp">

                    <AutoCompleteTextView
                        android:id="@+id/dropdownCuaca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:focusable="false"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:text="Data cuaca tidak tersedia"
                        android:textStyle="bold"
                        android:textColor="#0284C7"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 6. Kedalaman -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Kedalaman (Cth: 50 cm) - Kosongkan jika tidak ada">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKedalaman"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etCakupanDampak"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 7. Cakupan Dampak -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Cakupan Dampak (Wilayah / Desa / KK Terdampak)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCakupanDampak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="3"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etUpayaDilakukan"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 8. Upaya Dilakukan -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Upaya Dilakukan (Penanganan BPBD / TRC / Instansi)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUpayaDilakukan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="3"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etKondisiMutakhir"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 9. Kondisi Mutakhir -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Kondisi Mutakhir Lapangan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKondisiMutakhir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="3"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etKerusakan"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 10. Kerusakan -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Kerusakan (Rumah / Fasilitas Umum / Infrastruktur)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKerusakan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="3"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etPenyebab"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 11. Penyebab -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Penyebab Kejadian Bencana">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPenyebab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="3"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etSumberInformasi"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 12. Sumber Informasi -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sumber Informasi (Cth: BMKG / Camat / TRC BPBD)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSumberInformasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:textColor="#333333"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Spasi bawah ringkas agar tidak menyisakan ruang kosong berlebihan di atas keyboard -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
