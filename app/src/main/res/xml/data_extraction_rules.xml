<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bpbd_officer_auth_prefs.xml" />
        <exclude domain="sharedpref" path="bpbd_security_manager_prefs.xml" />
        <exclude domain="sharedpref" path="bpbd_integrity_device_binding.xml" />
        <exclude domain="sharedpref" path="PusdalopsSession.xml" />
        <exclude domain="file" path="datastore/user_session.preferences_pb" />
        <exclude domain="database" path="sipagar_database" />
        <exclude domain="database" path="sipagar_database-wal" />
        <exclude domain="database" path="sipagar_database-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bpbd_officer_auth_prefs.xml" />
        <exclude domain="sharedpref" path="bpbd_security_manager_prefs.xml" />
        <exclude domain="sharedpref" path="bpbd_integrity_device_binding.xml" />
        <exclude domain="sharedpref" path="PusdalopsSession.xml" />
        <exclude domain="file" path="datastore/user_session.preferences_pb" />
        <exclude domain="database" path="sipagar_database" />
        <exclude domain="database" path="sipagar_database-wal" />
        <exclude domain="database" path="sipagar_database-shm" />
    </device-transfer>
</data-extraction-rules>
