<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- BMKG, Open-Meteo, and cloud endpoints (HTTPS only) -->
    <domain-config>
        <domain includeSubdomains="true">data.bmkg.go.id</domain>
        <domain includeSubdomains="true">api.bmkg.go.id</domain>
        <domain includeSubdomains="true">bmkg.go.id</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
    </domain-config>
</network-security-config>
