{
  "entities": {
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User weather alert preferences and favorite districts in Mukomuko",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user ID owner"
        },
        "favoriteDistricts": {
          "type": "array",
          "description": "List of favorite Mukomuko district IDs (max 30)",
          "items": { "type": "string" }
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether severe weather push notifications are active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        }
      },
      "required": ["userId", "notificationsEnabled"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Crowd-sourced citizen weather report in Mukomuko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "districtId": { "type": "string" },
        "districtName": { "type": "string" },
        "reporterName": { "type": "string" },
        "weatherCondition": { "type": "string" },
        "notes": { "type": "string" },
        "upvotes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "districtName", "reporterName", "weatherCondition"]
    },
    "CitizenDisasterReport": {
      "title": "CitizenDisasterReport",
      "description": "Verified citizen disaster report for BPBD Mukomuko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string", "description": "Authenticated Firebase UID owner" },
        "disasterType": { "type": "string" },
        "incidentTime": { "type": "string" },
        "incidentLocation": { "type": "string" },
        "district": { "type": "string" },
        "village": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "gpsAccuracyMeters": { "type": "number" },
        "isGpsVerified": { "type": "boolean" },
        "casualtiesDead": { "type": "integer" },
        "casualtiesInjured": { "type": "integer" },
        "casualtiesMissing": { "type": "integer" },
        "photoUri": { "type": "string", "description": "HTTPS photo URL or inline compressed JPEG Data URI (data:image/jpeg;base64,..., max 400000 chars)" },
        "fotoUrl": { "type": "string", "description": "Primary Firebase Storage download URL (or portable photo URL) for officer inspection" },
        "fotoLampiran": { "type": "string", "description": "Mirror attachment URL for Firebase Storage citizen photo evidence" },
        "reporterName": { "type": "string" },
        "reporterPhone": { "type": "string" },
        "additionalNotes": { "type": "string" },
        "timestamp": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "status": { "type": "string" },
        "handledByOfficerName": { "type": "string", "description": "Active BPBD officer who validated or updated this report" },
        "handledByOfficerNip": { "type": "string", "description": "NIP of active BPBD officer handling this report" },
        "handledByOfficerRole": { "type": "string", "description": "Role of active BPBD officer handling this report" }
      },
      "required": ["id", "authorUid", "disasterType", "district", "status"]
    },
    "OfficerProfile": {
      "title": "OfficerProfile",
      "description": "Pusdalops & TRC officer profile in duty roster",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string", "description": "Authenticated Firebase UID owner" },
        "fullName": { "type": "string" },
        "nip": { "type": "string" },
        "role": { "type": "string" },
        "unit": { "type": "string" },
        "shift": { "type": "string" },
        "phone": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["ownerUid", "fullName", "nip", "role"]
    },
    "OfficerCredential": {
      "title": "OfficerCredential",
      "description": "Individual BPBD officer login credential with salted PBKDF2 PIN hash",
      "type": "object",
      "properties": {
        "nip": { "type": "string" },
        "ownerUid": { "type": "string", "description": "Authenticated Firebase UID owner" },
        "fullName": { "type": "string" },
        "role": { "type": "string" },
        "unit": { "type": "string" },
        "shift": { "type": "string" },
        "phone": { "type": "string" },
        "pinHash": { "type": "string" },
        "salt": { "type": "string" },
        "isCustomPinSet": { "type": "boolean" },
        "isPinChanged": { "type": "boolean" },
        "initialSecurePin": { "type": "string", "description": "Must always be empty string in cloud sync" },
        "lastLoginAt": { "type": "integer" },
        "lastLoginDevice": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["nip", "ownerUid", "fullName", "pinHash", "salt"]
    },
    "DatabaseBackup": {
      "title": "DatabaseBackup",
      "description": "User-scoped snapshot backup of disaster reports database",
      "type": "object",
      "properties": {
        "backupId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "backupDate": { "type": "integer" },
        "officerName": { "type": "string" },
        "totalReports": { "type": "integer" },
        "reports": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["backupId", "ownerUid", "backupDate", "officerName"]
    },
    "DeviceHeartbeat": {
      "title": "DeviceHeartbeat",
      "description": "Real-time heartbeat of active Pusdalops duty device",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "deviceModel": { "type": "string" },
        "officerName": { "type": "string" },
        "lastSeen": { "type": "integer" },
        "latencyMs": { "type": "integer" },
        "status": { "type": "string" }
      },
      "required": ["deviceId", "ownerUid", "status"]
    },
    "NetworkPing": {
      "title": "NetworkPing",
      "description": "Network latency measurement document",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "pingTimestamp": { "type": "integer" }
      },
      "required": ["deviceId", "ownerUid", "pingTimestamp"]
    },
    "DeviceSecuritySession": {
      "title": "DeviceSecuritySession",
      "description": "Play Integrity session, hardware telemetry, login activity summary, and admin verification record for Ruang Kerja access gating",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "nip": { "type": "string" },
        "officerNip": { "type": "string" },
        "officerName": { "type": "string" },
        "officerRole": { "type": "string" },
        "integrityToken": { "type": "string" },
        "tokenHash": { "type": "string" },
        "tokenLength": { "type": "integer" },
        "tokenSource": { "type": "string" },
        "classicNonce": { "type": "string" },
        "verdict": { "type": "string" },
        "deviceVerdict": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "deviceBrand": { "type": "string" },
        "deviceManufacturer": { "type": "string" },
        "deviceHardware": { "type": "string" },
        "deviceFingerprintHash": { "type": "string" },
        "isEmulator": { "type": "boolean" },
        "osVersion": { "type": "string" },
        "sdkInt": { "type": "integer" },
        "appVersion": { "type": "string" },
        "loginMethod": { "type": "string" },
        "loginStatus": { "type": "string" },
        "loginAction": { "type": "string" },
        "loginCount": { "type": "integer" },
        "lastActivityDetail": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "accessGranted": { "type": "boolean" },
        "adminVerified": { "type": "boolean" },
        "adminVerifiedBy": { "type": "string" },
        "adminVerifiedAt": { "type": "integer" },
        "adminVerificationNote": { "type": "string" },
        "targetModule": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["sessionId", "ownerUid", "officerNip", "accessGranted", "timestamp"]
    },
    "DeviceLoginActivity": {
      "title": "DeviceLoginActivity",
      "description": "Append-only chronological log of every officer login activity with Play Integrity Classic token and hardware attestation details",
      "type": "object",
      "properties": {
        "activityId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "sessionId": { "type": "string" },
        "officerNip": { "type": "string" },
        "officerName": { "type": "string" },
        "officerRole": { "type": "string" },
        "loginMethod": { "type": "string" },
        "loginStatus": { "type": "string" },
        "action": { "type": "string" },
        "verdict": { "type": "string" },
        "deviceVerdict": { "type": "string" },
        "tokenSource": { "type": "string" },
        "tokenHash": { "type": "string" },
        "tokenLength": { "type": "integer" },
        "classicNonce": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "deviceBrand": { "type": "string" },
        "deviceHardware": { "type": "string" },
        "deviceFingerprintHash": { "type": "string" },
        "osVersion": { "type": "string" },
        "sdkInt": { "type": "integer" },
        "isEmulator": { "type": "boolean" },
        "appVersion": { "type": "string" },
        "accessGranted": { "type": "boolean" },
        "detail": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["activityId", "ownerUid", "officerNip", "loginMethod", "loginStatus", "action", "timestamp"]
    },
    "DeviceSecurityFailure": {
      "title": "DeviceSecurityFailure",
      "description": "Append-only security validation failure audit log entry",
      "type": "object",
      "properties": {
        "failureId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "officerNip": { "type": "string" },
        "reason": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "sdkInt": { "type": "integer" },
        "recordedSessionId": { "type": "string" },
        "recordedVerdict": { "type": "string" },
        "recordedTokenHash": { "type": "string" },
        "targetModule": { "type": "string" },
        "additionalDetails": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["failureId", "ownerUid", "officerNip", "reason", "timestamp"]
    },
    "OfficerSession": {
      "title": "OfficerSession",
      "description": "Firestore-backed active officer session record",
      "type": "object",
      "properties": {
        "nip": { "type": "string" },
        "device_name": { "type": "string" },
        "os_version": { "type": "string" },
        "login_time": { "type": "integer" },
        "is_active": { "type": "boolean" },
        "sessionId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "officerNip": { "type": "string" },
        "officerName": { "type": "string" },
        "officerRole": { "type": "string" },
        "verdict": { "type": "string" },
        "accessGranted": { "type": "boolean" },
        "timestamp": { "type": "integer" }
      },
      "required": ["nip", "device_name", "os_version", "login_time", "is_active"]
    },
    "AdminAccessAuditLog": {
      "title": "AdminAccessAuditLog",
      "description": "Append-only audit trail for privileged admin authorization attempts",
      "type": "object",
      "properties": {
        "officerNip": { "type": "string" },
        "officerName": { "type": "string" },
        "officerRole": { "type": "string" },
        "actionCode": { "type": "string" },
        "actionTitle": { "type": "string" },
        "success": { "type": "boolean" },
        "detail": { "type": "string" },
        "timestamp": { "type": "integer" },
        "deviceModel": { "type": "string" }
      },
      "required": ["officerNip", "officerName", "officerRole", "actionCode", "actionTitle", "success", "detail", "timestamp"]
    },
    "BpbdVolunteer": {
      "title": "BpbdVolunteer",
      "description": "BPBD Mukomuko disaster volunteer record keyed by 16-digit NIK primary key",
      "type": "object",
      "properties": {
        "nik": { "type": "string" },
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "organization": { "type": "string" },
        "skillsCsv": { "type": "string" },
        "homeDistrict": { "type": "string" },
        "assignedDistrict": { "type": "string" },
        "assignedPoskoName": { "type": "string" },
        "assignedShift": { "type": "string" },
        "status": { "type": "string" },
        "isActive": { "type": "boolean" },
        "needsAssistance": { "type": "boolean" },
        "assistanceNote": { "type": "string" },
        "selfiePhotoUri": { "type": "string" },
        "certificatePhotoUri": { "type": "string" },
        "waktu_checkin": { "type": "integer" },
        "waktu_checkout": { "type": "integer" },
        "suratTugasNumber": { "type": "string" },
        "suratTugasPdfPath": { "type": "string" },
        "registeredAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "verifiedByOfficer": { "type": "string" },
        "isSyncedToCloud": { "type": "boolean" }
      },
      "required": ["id", "fullName", "nik", "phoneNumber", "organization", "skillsCsv", "status"]
    },
    "AppUsageGuide": {
      "title": "AppUsageGuide",
      "description": "Cloud-synced dynamic SIPAGAR KITA usage guide for Citizen and Officer modes without APK reinstall",
      "type": "object",
      "properties": {
        "guideVersion": { "type": "string" },
        "releaseTitle": { "type": "string" },
        "updatedAtLabel": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "integer" },
        "citizenSummary": { "type": "string" },
        "officerSummary": { "type": "string" },
        "citizenSteps": { "type": "array", "items": { "type": "object" } },
        "officerSteps": { "type": "array", "items": { "type": "object" } }
      },
      "required": [
        "guideVersion", "releaseTitle", "updatedAtLabel", "updatedBy", "updatedAt",
        "citizenSummary", "officerSummary", "citizenSteps", "officerSteps"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/preferences/{preferenceId}": {
      "schema": "UserPreferences",
      "description": "Private user preferences and notification settings"
    },
    "/community_reports/{reportId}": {
      "schema": "CommunityReport",
      "description": "Authenticated citizen crowd-sourced weather reports"
    },
    "/citizen_disaster_reports/{reportId}": {
      "schema": "CitizenDisasterReport",
      "description": "Official citizen disaster reports synced between Room and Firestore"
    },
    "/officers/{officerId}": {
      "schema": "OfficerProfile",
      "description": "BPBD Pusdalops & TRC duty personnel roster"
    },
    "/officer_credentials/{nip}": {
      "schema": "OfficerCredential",
      "description": "Individual BPBD officer login credentials and salted PIN hashes"
    },
    "/database_backups/{backupId}": {
      "schema": "DatabaseBackup",
      "description": "User-scoped disaster reports database cloud archives"
    },
    "/device_heartbeats/{deviceId}": {
      "schema": "DeviceHeartbeat",
      "description": "Active duty device heartbeats"
    },
    "/network_pings/{deviceId}": {
      "schema": "NetworkPing",
      "description": "Firestore latency measurement pings"
    },
    "/device_security_sessions/{officerNip}": {
      "schema": "DeviceSecuritySession",
      "description": "Play Integrity verified device sessions authorizing access to Ruang Kerja"
    },
    "/officer_sessions/{sessionId}": {
      "schema": "OfficerSession",
      "description": "Firestore-backed active officer session management documents"
    },
    "/admin_access_audit_logs/{logId}": {
      "schema": "AdminAccessAuditLog",
      "description": "Append-only admin authorization audit trail"
    },
    "/device_login_activities/{activityId}": {
      "schema": "DeviceLoginActivity",
      "description": "Append-only officer login activity trail with hardware and Play Integrity Classic telemetry"
    },
    "/device_security_failures/{failureId}": {
      "schema": "DeviceSecurityFailure",
      "description": "Append-only Play Integrity failure audit trail"
    },
    "/bpbd_volunteers/{volunteerId}": {
      "schema": "BpbdVolunteer",
      "description": "Offline-first synced BPBD Mukomuko volunteer coordination records (NIK PK)"
    },
    "/app_settings/usage_guide": {
      "schema": "AppUsageGuide",
      "description": "Cloud-synced dynamic usage guide for Citizens and Officers"
    }
  }
}
