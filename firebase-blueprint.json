{
  "entities": {
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User weather alert preferences and favorite districts in Mukomuko",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user ID owner"
        },
        "favoriteDistricts": {
          "type": "array",
          "description": "List of favorite Mukomuko district IDs (max 30)",
          "items": { "type": "string" }
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether severe weather push notifications are active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        }
      },
      "required": ["userId", "notificationsEnabled"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Crowd-sourced citizen weather report in Mukomuko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "districtId": { "type": "string" },
        "districtName": { "type": "string" },
        "reporterName": { "type": "string" },
        "weatherCondition": { "type": "string" },
        "notes": { "type": "string" },
        "upvotes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "districtName", "reporterName", "weatherCondition"]
    },
    "CitizenDisasterReport": {
      "title": "CitizenDisasterReport",
      "description": "Verified citizen disaster report for BPBD Mukomuko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string", "description": "Authenticated Firebase UID owner" },
        "disasterType": { "type": "string" },
        "incidentTime": { "type": "string" },
        "incidentLocation": { "type": "string" },
        "district": { "type": "string" },
        "village": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "gpsAccuracyMeters": { "type": "number" },
        "isGpsVerified": { "type": "boolean" },
        "casualtiesDead": { "type": "integer" },
        "casualtiesInjured": { "type": "integer" },
        "casualtiesMissing": { "type": "integer" },
        "photoUri": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterPhone": { "type": "string" },
        "additionalNotes": { "type": "string" },
        "timestamp": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "status": { "type": "string" }
      },
      "required": ["id", "authorUid", "disasterType", "district", "status"]
    },
    "OfficerProfile": {
      "title": "OfficerProfile",
      "description": "Pusdalops & TRC officer profile in duty roster",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string", "description": "Authenticated Firebase UID owner" },
        "fullName": { "type": "string" },
        "nip": { "type": "string" },
        "role": { "type": "string" },
        "unit": { "type": "string" },
        "shift": { "type": "string" },
        "phone": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["ownerUid", "fullName", "nip", "role"]
    },
    "OfficerCredential": {
      "title": "OfficerCredential",
      "description": "Individual BPBD officer login credential with salted PBKDF2 PIN hash",
      "type": "object",
      "properties": {
        "nip": { "type": "string" },
        "ownerUid": { "type": "string", "description": "Authenticated Firebase UID owner" },
        "fullName": { "type": "string" },
        "role": { "type": "string" },
        "unit": { "type": "string" },
        "shift": { "type": "string" },
        "phone": { "type": "string" },
        "pinHash": { "type": "string" },
        "salt": { "type": "string" },
        "isCustomPinSet": { "type": "boolean" },
        "isPinChanged": { "type": "boolean" },
        "initialSecurePin": { "type": "string", "description": "Must always be empty string in cloud sync" },
        "lastLoginAt": { "type": "integer" },
        "lastLoginDevice": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["nip", "ownerUid", "fullName", "pinHash", "salt"]
    },
    "DatabaseBackup": {
      "title": "DatabaseBackup",
      "description": "User-scoped snapshot backup of disaster reports database",
      "type": "object",
      "properties": {
        "backupId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "backupDate": { "type": "integer" },
        "officerName": { "type": "string" },
        "totalReports": { "type": "integer" },
        "reports": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["backupId", "ownerUid", "backupDate", "officerName"]
    },
    "DeviceHeartbeat": {
      "title": "DeviceHeartbeat",
      "description": "Real-time heartbeat of active Pusdalops duty device",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "deviceModel": { "type": "string" },
        "officerName": { "type": "string" },
        "lastSeen": { "type": "integer" },
        "latencyMs": { "type": "integer" },
        "status": { "type": "string" }
      },
      "required": ["deviceId", "ownerUid", "status"]
    },
    "NetworkPing": {
      "title": "NetworkPing",
      "description": "Network latency measurement document",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "pingTimestamp": { "type": "integer" }
      },
      "required": ["deviceId", "ownerUid", "pingTimestamp"]
    },
    "DeviceSecuritySession": {
      "title": "DeviceSecuritySession",
      "description": "Play Integrity session and device trust record for Ruang Kerja access gating",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "nip": { "type": "string" },
        "officerNip": { "type": "string" },
        "officerName": { "type": "string" },
        "officerRole": { "type": "string" },
        "integrityToken": { "type": "string" },
        "tokenHash": { "type": "string" },
        "classicNonce": { "type": "string" },
        "verdict": { "type": "string" },
        "deviceVerdict": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "sdkInt": { "type": "integer" },
        "isVerified": { "type": "boolean" },
        "accessGranted": { "type": "boolean" },
        "targetModule": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["sessionId", "ownerUid", "officerNip", "accessGranted", "timestamp"]
    },
    "DeviceSecurityFailure": {
      "title": "DeviceSecurityFailure",
      "description": "Append-only security validation failure audit log entry",
      "type": "object",
      "properties": {
        "failureId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "officerNip": { "type": "string" },
        "reason": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "sdkInt": { "type": "integer" },
        "recordedSessionId": { "type": "string" },
        "recordedVerdict": { "type": "string" },
        "recordedTokenHash": { "type": "string" },
        "targetModule": { "type": "string" },
        "additionalDetails": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["failureId", "ownerUid", "officerNip", "reason", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}/preferences/{preferenceId}": {
      "schema": "UserPreferences",
      "description": "Private user preferences and notification settings"
    },
    "/community_reports/{reportId}": {
      "schema": "CommunityReport",
      "description": "Authenticated citizen crowd-sourced weather reports"
    },
    "/citizen_disaster_reports/{reportId}": {
      "schema": "CitizenDisasterReport",
      "description": "Official citizen disaster reports synced between Room and Firestore"
    },
    "/officers/{officerId}": {
      "schema": "OfficerProfile",
      "description": "BPBD Pusdalops & TRC duty personnel roster"
    },
    "/officer_credentials/{nip}": {
      "schema": "OfficerCredential",
      "description": "Individual BPBD officer login credentials and salted PIN hashes"
    },
    "/database_backups/{backupId}": {
      "schema": "DatabaseBackup",
      "description": "User-scoped disaster reports database cloud archives"
    },
    "/device_heartbeats/{deviceId}": {
      "schema": "DeviceHeartbeat",
      "description": "Active duty device heartbeats"
    },
    "/network_pings/{deviceId}": {
      "schema": "NetworkPing",
      "description": "Firestore latency measurement pings"
    },
    "/device_security_sessions/{officerNip}": {
      "schema": "DeviceSecuritySession",
      "description": "Play Integrity verified device sessions authorizing access to Ruang Kerja"
    },
    "/device_security_failures/{failureId}": {
      "schema": "DeviceSecurityFailure",
      "description": "Append-only Play Integrity failure audit trail"
    }
  }
}
