rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Preferences
    match /users/{userId}/preferences/{prefId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.notificationsEnabled is bool;
      allow update: if isOwner(userId)
                    && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // Community Citizen Weather Reports
    match /community_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.districtId is string
                    && request.resource.data.districtName is string
                    && request.resource.data.weatherCondition is string
                    && request.resource.data.reporterName is string;
      allow update: if isAuthenticated() && (
        // Author updating their own report
        resource.data.userId == request.auth.uid ||
        // Other authenticated users upvoting
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
