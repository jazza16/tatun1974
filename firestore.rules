rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 4.1: Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- VALIDATION HELPERS ---

    function isValidUserPreferences(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
          && data.notificationsEnabled is bool
          && (!('favoriteDistricts' in data) || (
               data.favoriteDistricts is list
               && data.favoriteDistricts.size() <= 30
               && (data.favoriteDistricts.size() == 0 || data.favoriteDistricts[0] is string)
             ))
          && (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time))
          && (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCommunityReport(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
          && data.districtName is string && data.districtName.size() >= 1 && data.districtName.size() <= 100
          && data.weatherCondition is string && data.weatherCondition.size() >= 1 && data.weatherCondition.size() <= 120
          && (!('id' in data) || (data.id is string && data.id.size() <= 128))
          && (!('districtId' in data) || (data.districtId is string && data.districtId.size() <= 80))
          && (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 100))
          && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
          && (!('upvotes' in data) || (data.upvotes is int && data.upvotes >= 0 && data.upvotes <= 1000000))
          && (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time))
          && (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCitizenDisasterReport(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128
          && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
          && data.disasterType is string && data.disasterType.size() >= 1 && data.disasterType.size() <= 120
          && data.district is string && data.district.size() >= 1 && data.district.size() <= 100
          && data.status is string && data.status.size() >= 1 && data.status.size() <= 64
          && (!('incidentTime' in data) || (data.incidentTime is string && data.incidentTime.size() <= 80))
          && (!('incidentLocation' in data) || (data.incidentLocation is string && data.incidentLocation.size() <= 300))
          && (!('village' in data) || (data.village is string && data.village.size() <= 120))
          && (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
          && (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
          && (!('gpsAccuracyMeters' in data) || data.gpsAccuracyMeters == null || (data.gpsAccuracyMeters is number && data.gpsAccuracyMeters >= 0 && data.gpsAccuracyMeters <= 100000))
          && (!('isGpsVerified' in data) || data.isGpsVerified is bool)
          && (!('casualtiesDead' in data) || (data.casualtiesDead is int && data.casualtiesDead >= 0 && data.casualtiesDead <= 100000))
          && (!('casualtiesInjured' in data) || (data.casualtiesInjured is int && data.casualtiesInjured >= 0 && data.casualtiesInjured <= 100000))
          && (!('casualtiesMissing' in data) || (data.casualtiesMissing is int && data.casualtiesMissing >= 0 && data.casualtiesMissing <= 100000))
          && (!('photoUri' in data) || data.photoUri == null || (data.photoUri is string && data.photoUri.size() <= 400000))
          && (!('fotoUrl' in data) || data.fotoUrl == null || (data.fotoUrl is string && data.fotoUrl.size() <= 400000))
          && (!('fotoLampiran' in data) || data.fotoLampiran == null || (data.fotoLampiran is string && data.fotoLampiran.size() <= 400000))
          && (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 120))
          && (!('reporterPhone' in data) || (data.reporterPhone is string && data.reporterPhone.size() <= 40))
          && (!('additionalNotes' in data) || (data.additionalNotes is string && data.additionalNotes.size() <= 2000))
          && (!('timestamp' in data) || data.timestamp is int)
          && (!('updatedAt' in data) || data.updatedAt is int)
          && (!('handledByOfficerName' in data) || (data.handledByOfficerName is string && data.handledByOfficerName.size() <= 150))
          && (!('handledByOfficerNip' in data) || (data.handledByOfficerNip is string && data.handledByOfficerNip.size() <= 64))
          && (!('handledByOfficerRole' in data) || (data.handledByOfficerRole is string && data.handledByOfficerRole.size() <= 80));
    }

    function isValidOfficerProfile(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
          && data.nip is string && data.nip.size() >= 1 && data.nip.size() <= 64
          && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
          && (!('id' in data) || (data.id is string && data.id.size() <= 128))
          && (!('unit' in data) || (data.unit is string && data.unit.size() <= 150))
          && (!('shift' in data) || (data.shift is string && data.shift.size() <= 80))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
          && (!('updatedAt' in data) || data.updatedAt is int)
          && (!('isDeleted' in data) || data.isDeleted is bool)
          && (!('deletedAt' in data) || data.deletedAt is int)
          && (!('deletedReason' in data) || (data.deletedReason is string && data.deletedReason.size() <= 200));
    }

    function isValidOfficerCredential(data) {
      return data.nip is string && data.nip.size() >= 1 && data.nip.size() <= 64
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
          && data.pinHash is string && data.pinHash.size() >= 32 && data.pinHash.size() <= 256
          && data.salt is string && data.salt.size() >= 16 && data.salt.size() <= 128
          && (!('role' in data) || (data.role is string && data.role.size() <= 80))
          && (!('unit' in data) || (data.unit is string && data.unit.size() <= 150))
          && (!('shift' in data) || (data.shift is string && data.shift.size() <= 80))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
          && (!('isCustomPinSet' in data) || data.isCustomPinSet is bool)
          && (!('isPinChanged' in data) || data.isPinChanged is bool)
          // Never store plaintext initial PIN in Firestore
          && (!('initialSecurePin' in data) || (data.initialSecurePin is string && data.initialSecurePin.size() == 0))
          && (!('lastLoginAt' in data) || data.lastLoginAt is int)
          && (!('lastLoginDevice' in data) || (data.lastLoginDevice is string && data.lastLoginDevice.size() <= 150))
          && (!('updatedAt' in data) || data.updatedAt is int);
    }

    function isValidDatabaseBackup(data) {
      return data.backupId is string && data.backupId.size() >= 1 && data.backupId.size() <= 128
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.backupDate is int
          && data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 150
          && (!('totalReports' in data) || (data.totalReports is int && data.totalReports >= 0 && data.totalReports <= 5000))
          && (!('reports' in data) || (data.reports is list && data.reports.size() <= 500));
    }

    function isValidDeviceHeartbeat(data) {
      return data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.status is string && data.status.size() >= 1 && data.status.size() <= 32
          && (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 120))
          && (!('officerName' in data) || (data.officerName is string && data.officerName.size() <= 150))
          && (!('lastSeen' in data) || data.lastSeen is int)
          && (!('latencyMs' in data) || (data.latencyMs is int && data.latencyMs >= 0 && data.latencyMs <= 300000));
    }

    function isValidNetworkPing(data) {
      return data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.pingTimestamp is int;
    }

    function isValidDeviceSecuritySession(data) {
      return data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.officerNip is string && data.officerNip.size() >= 1 && data.officerNip.size() <= 64
          && data.accessGranted is bool
          && data.timestamp is int
          && (!('nip' in data) || (data.nip is string && data.nip.size() <= 64))
          && (!('officerName' in data) || (data.officerName is string && data.officerName.size() <= 150))
          && (!('officerRole' in data) || (data.officerRole is string && data.officerRole.size() <= 80))
          && (!('integrityToken' in data) || (data.integrityToken is string && data.integrityToken.size() <= 4096))
          && (!('tokenHash' in data) || (data.tokenHash is string && data.tokenHash.size() <= 128))
          && (!('tokenLength' in data) || (data.tokenLength is int && data.tokenLength >= 0 && data.tokenLength <= 8192))
          && (!('tokenSource' in data) || (data.tokenSource is string && data.tokenSource.size() <= 80))
          && (!('classicNonce' in data) || (data.classicNonce is string && data.classicNonce.size() <= 256))
          && (!('verdict' in data) || (data.verdict is string && data.verdict.size() <= 80))
          && (!('deviceVerdict' in data) || (data.deviceVerdict is string && data.deviceVerdict.size() <= 120))
          && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128))
          && (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 120))
          && (!('deviceBrand' in data) || (data.deviceBrand is string && data.deviceBrand.size() <= 80))
          && (!('deviceManufacturer' in data) || (data.deviceManufacturer is string && data.deviceManufacturer.size() <= 80))
          && (!('deviceHardware' in data) || (data.deviceHardware is string && data.deviceHardware.size() <= 80))
          && (!('deviceFingerprintHash' in data) || (data.deviceFingerprintHash is string && data.deviceFingerprintHash.size() <= 128))
          && (!('isEmulator' in data) || data.isEmulator is bool)
          && (!('osVersion' in data) || (data.osVersion is string && data.osVersion.size() <= 80))
          && (!('sdkInt' in data) || (data.sdkInt is int && data.sdkInt >= 0 && data.sdkInt <= 100))
          && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 64))
          && (!('loginMethod' in data) || (data.loginMethod is string && data.loginMethod.size() <= 64))
          && (!('loginStatus' in data) || (data.loginStatus is string && data.loginStatus.size() <= 64))
          && (!('loginAction' in data) || (data.loginAction is string && data.loginAction.size() <= 120))
          && (!('loginCount' in data) || (data.loginCount is int && data.loginCount >= 0 && data.loginCount <= 1000000))
          && (!('lastActivityDetail' in data) || (data.lastActivityDetail is string && data.lastActivityDetail.size() <= 500))
          && (!('isVerified' in data) || data.isVerified is bool)
          && (!('adminVerified' in data) || data.adminVerified is bool)
          && (!('adminVerifiedBy' in data) || (data.adminVerifiedBy is string && data.adminVerifiedBy.size() <= 150))
          && (!('adminVerifiedAt' in data) || (data.adminVerifiedAt is int && data.adminVerifiedAt >= 0))
          && (!('adminVerificationNote' in data) || (data.adminVerificationNote is string && data.adminVerificationNote.size() <= 500))
          && (!('targetModule' in data) || (data.targetModule is string && data.targetModule.size() <= 64));
    }

    function isValidDeviceLoginActivity(data) {
      return data.activityId is string && data.activityId.size() >= 1 && data.activityId.size() <= 128
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.officerNip is string && data.officerNip.size() >= 1 && data.officerNip.size() <= 64
          && data.loginMethod is string && data.loginMethod.size() >= 1 && data.loginMethod.size() <= 64
          && data.loginStatus is string && data.loginStatus.size() >= 1 && data.loginStatus.size() <= 64
          && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
          && data.timestamp is int
          && (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128))
          && (!('officerName' in data) || (data.officerName is string && data.officerName.size() <= 150))
          && (!('officerRole' in data) || (data.officerRole is string && data.officerRole.size() <= 80))
          && (!('verdict' in data) || (data.verdict is string && data.verdict.size() <= 80))
          && (!('deviceVerdict' in data) || (data.deviceVerdict is string && data.deviceVerdict.size() <= 120))
          && (!('tokenSource' in data) || (data.tokenSource is string && data.tokenSource.size() <= 80))
          && (!('tokenHash' in data) || (data.tokenHash is string && data.tokenHash.size() <= 128))
          && (!('tokenLength' in data) || (data.tokenLength is int && data.tokenLength >= 0 && data.tokenLength <= 8192))
          && (!('classicNonce' in data) || (data.classicNonce is string && data.classicNonce.size() <= 256))
          && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128))
          && (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 120))
          && (!('deviceBrand' in data) || (data.deviceBrand is string && data.deviceBrand.size() <= 80))
          && (!('deviceHardware' in data) || (data.deviceHardware is string && data.deviceHardware.size() <= 80))
          && (!('deviceFingerprintHash' in data) || (data.deviceFingerprintHash is string && data.deviceFingerprintHash.size() <= 128))
          && (!('osVersion' in data) || (data.osVersion is string && data.osVersion.size() <= 80))
          && (!('sdkInt' in data) || (data.sdkInt is int && data.sdkInt >= 0 && data.sdkInt <= 100))
          && (!('isEmulator' in data) || data.isEmulator is bool)
          && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 64))
          && (!('accessGranted' in data) || data.accessGranted is bool)
          && (!('detail' in data) || (data.detail is string && data.detail.size() <= 500));
    }

    function isValidDeviceSecurityFailure(data) {
      return data.failureId is string && data.failureId.size() >= 1 && data.failureId.size() <= 128
          && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
          && data.officerNip is string && data.officerNip.size() <= 64
          && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
          && data.timestamp is int
          && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128))
          && (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 120))
          && (!('osVersion' in data) || (data.osVersion is string && data.osVersion.size() <= 80))
          && (!('sdkInt' in data) || (data.sdkInt is int && data.sdkInt >= 0 && data.sdkInt <= 100))
          && (!('recordedSessionId' in data) || (data.recordedSessionId is string && data.recordedSessionId.size() <= 128))
          && (!('recordedVerdict' in data) || (data.recordedVerdict is string && data.recordedVerdict.size() <= 80))
          && (!('recordedTokenHash' in data) || (data.recordedTokenHash is string && data.recordedTokenHash.size() <= 128))
          && (!('targetModule' in data) || (data.targetModule is string && data.targetModule.size() <= 64))
          && (!('additionalDetails' in data) || (data.additionalDetails is string && data.additionalDetails.size() <= 1000));
    }

    function isValidOfficerSession(data) {
      return data.nip is string && data.nip.size() >= 1 && data.nip.size() <= 64
          && data.device_name is string && data.device_name.size() >= 1 && data.device_name.size() <= 120
          && data.os_version is string && data.os_version.size() >= 1 && data.os_version.size() <= 80
          && data.login_time is int
          && data.is_active is bool
          && (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128))
          && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
          && (!('officerNip' in data) || (data.officerNip is string && data.officerNip.size() <= 64))
          && (!('officerName' in data) || (data.officerName is string && data.officerName.size() <= 150))
          && (!('officerRole' in data) || (data.officerRole is string && data.officerRole.size() <= 80))
          && (!('integrityToken' in data) || (data.integrityToken is string && data.integrityToken.size() <= 8192))
          && (!('tokenHash' in data) || (data.tokenHash is string && data.tokenHash.size() <= 128))
          && (!('tokenLength' in data) || (data.tokenLength is int && data.tokenLength >= 0 && data.tokenLength <= 8192))
          && (!('tokenSource' in data) || (data.tokenSource is string && data.tokenSource.size() <= 80))
          && (!('classicNonce' in data) || (data.classicNonce is string && data.classicNonce.size() <= 256))
          && (!('verdict' in data) || (data.verdict is string && data.verdict.size() <= 80))
          && (!('deviceVerdict' in data) || (data.deviceVerdict is string && data.deviceVerdict.size() <= 120))
          && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128))
          && (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 120))
          && (!('deviceBrand' in data) || (data.deviceBrand is string && data.deviceBrand.size() <= 80))
          && (!('deviceManufacturer' in data) || (data.deviceManufacturer is string && data.deviceManufacturer.size() <= 80))
          && (!('deviceHardware' in data) || (data.deviceHardware is string && data.deviceHardware.size() <= 80))
          && (!('deviceFingerprintHash' in data) || (data.deviceFingerprintHash is string && data.deviceFingerprintHash.size() <= 128))
          && (!('isEmulator' in data) || data.isEmulator is bool)
          && (!('osVersion' in data) || (data.osVersion is string && data.osVersion.size() <= 80))
          && (!('sdkInt' in data) || (data.sdkInt is int && data.sdkInt >= 0 && data.sdkInt <= 100))
          && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 64))
          && (!('loginMethod' in data) || (data.loginMethod is string && data.loginMethod.size() <= 64))
          && (!('loginStatus' in data) || (data.loginStatus is string && data.loginStatus.size() <= 64))
          && (!('loginAction' in data) || (data.loginAction is string && data.loginAction.size() <= 120))
          && (!('loginCount' in data) || (data.loginCount is int && data.loginCount >= 0 && data.loginCount <= 1000000))
          && (!('lastActivityDetail' in data) || (data.lastActivityDetail is string && data.lastActivityDetail.size() <= 500))
          && (!('isVerified' in data) || data.isVerified is bool)
          && (!('accessGranted' in data) || data.accessGranted is bool)
          && (!('adminVerified' in data) || data.adminVerified is bool)
          && (!('adminVerifiedBy' in data) || (data.adminVerifiedBy is string && data.adminVerifiedBy.size() <= 150))
          && (!('adminVerifiedAt' in data) || (data.adminVerifiedAt is int && data.adminVerifiedAt >= 0))
          && (!('adminVerificationNote' in data) || (data.adminVerificationNote is string && data.adminVerificationNote.size() <= 500))
          && (!('targetModule' in data) || (data.targetModule is string && data.targetModule.size() <= 64))
          && (!('timestamp' in data) || data.timestamp is int);
    }

    // --- COLLECTION RULES ---

    // 1. User Preferences & Notification Settings (User-scoped subcollection)
    match /users/{userId}/preferences/{prefId} {
      allow get: if isOwner(userId) && isValidId(prefId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(prefId)
                    && incoming().userId == request.auth.uid
                    && incoming().keys().hasAll(['userId', 'notificationsEnabled'])
                    && incoming().keys().hasOnly(['userId', 'favoriteDistricts', 'notificationsEnabled', 'createdAt', 'updatedAt'])
                    && isValidUserPreferences(incoming());
      allow update: if isOwner(userId)
                    && isValidId(prefId)
                    && isValidUserPreferences(incoming())
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['favoriteDistricts', 'notificationsEnabled', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(prefId);
    }

    // 2. Citizen Community Weather Reports
    match /community_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(reportId)
                    && incoming().userId == request.auth.uid
                    && incoming().keys().hasAll(['userId', 'districtName', 'weatherCondition'])
                    && incoming().keys().hasOnly(['id', 'userId', 'districtId', 'districtName', 'reporterName', 'weatherCondition', 'notes', 'upvotes', 'createdAt', 'updatedAt'])
                    && isValidCommunityReport(incoming());
      allow update: if isSignedIn()
                    && isValidId(reportId)
                    && isValidCommunityReport(incoming())
                    && incoming().userId == existing().userId
                    && (
                      (existing().userId == request.auth.uid
                        && incoming().diff(existing()).affectedKeys().hasOnly(['districtId', 'districtName', 'reporterName', 'weatherCondition', 'notes', 'upvotes', 'updatedAt']))
                      || incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt'])
                    );
      allow delete: if isSignedIn() && isValidId(reportId) && existing().userId == request.auth.uid;
    }

    // 3. Citizen Disaster Reports (SIPAGAR KITA BPBD Mukomuko)
    match /citizen_disaster_reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId)
                    && incoming().keys().hasAll(['id', 'authorUid', 'disasterType', 'district', 'status'])
                    && incoming().keys().hasOnly([
                         'id', 'authorUid', 'disasterType', 'incidentTime', 'incidentLocation',
                         'district', 'village', 'latitude', 'longitude', 'gpsAccuracyMeters',
                         'isGpsVerified', 'casualtiesDead', 'casualtiesInjured', 'casualtiesMissing',
                          'photoUri', 'fotoUrl', 'fotoLampiran', 'reporterName', 'reporterPhone', 'additionalNotes',
                         'timestamp', 'updatedAt', 'status',
                         'handledByOfficerName', 'handledByOfficerNip', 'handledByOfficerRole'
                       ])
                    && isValidCitizenDisasterReport(incoming());
      allow update: if isValidId(reportId)
                    && (!('id' in existing()) || incoming().id == existing().id)
                    && (!('authorUid' in existing()) || incoming().authorUid == existing().authorUid)
                    && (
                      // Action: Officer status / follow-up / tombstone update
                      (
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'status', 'additionalNotes', 'updatedAt',
                          'handledByOfficerName', 'handledByOfficerNip', 'handledByOfficerRole'
                        ])
                        && incoming().status is string && incoming().status.size() >= 1 && incoming().status.size() <= 64
                        && (!('additionalNotes' in incoming()) || (incoming().additionalNotes is string && incoming().additionalNotes.size() <= 2000))
                        && (!('updatedAt' in incoming()) || incoming().updatedAt is int)
                        && (!('handledByOfficerName' in incoming()) || (incoming().handledByOfficerName is string && incoming().handledByOfficerName.size() <= 150))
                        && (!('handledByOfficerNip' in incoming()) || (incoming().handledByOfficerNip is string && incoming().handledByOfficerNip.size() <= 64))
                        && (!('handledByOfficerRole' in incoming()) || (incoming().handledByOfficerRole is string && incoming().handledByOfficerRole.size() <= 80))
                      )
                      // Action: Full report sync update (preserving id & authorUid)
                      || (
                        isValidCitizenDisasterReport(incoming())
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                             'disasterType', 'incidentTime', 'incidentLocation', 'district', 'village',
                             'latitude', 'longitude', 'gpsAccuracyMeters', 'isGpsVerified',
                             'casualtiesDead', 'casualtiesInjured', 'casualtiesMissing',
                             'photoUri', 'fotoUrl', 'fotoLampiran', 'reporterName', 'reporterPhone', 'additionalNotes',
                             'timestamp', 'updatedAt', 'status',
                             'handledByOfficerName', 'handledByOfficerNip', 'handledByOfficerRole'
                           ])
                      )
                    );
      allow delete: if isSignedIn() && isValidId(reportId) && existing().authorUid == request.auth.uid;
    }

    // 4. Pusdalops & TRC Official Officers Directory
    match /officers/{officerId} {
      allow get: if isValidId(officerId);
      allow list: if true;
      allow create: if isValidId(officerId)
                    && incoming().keys().hasAll(['ownerUid', 'fullName', 'nip', 'role'])
                    && incoming().keys().hasOnly(['id', 'ownerUid', 'fullName', 'nip', 'role', 'unit', 'shift', 'phone', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedReason'])
                    && isValidOfficerProfile(incoming())
                    && (
                      (isSignedIn() && incoming().ownerUid == request.auth.uid)
                      || (!isSignedIn() && incoming().ownerUid == ('officer_nip_' + incoming().nip))
                    );
      allow update: if isValidId(officerId)
                    && isValidOfficerProfile(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'ownerUid', 'fullName', 'nip', 'role', 'unit', 'shift', 'phone', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedReason'])
                    && (
                      (isSignedIn() && incoming().ownerUid == request.auth.uid)
                      || (!isSignedIn() && incoming().ownerUid == ('officer_nip_' + incoming().nip))
                    );
      allow delete: if isValidId(officerId);
    }

    // 5. Pusdalops & TRC Individual Officer Credentials & Custom PIN Sync (No plaintext initial PIN)
    match /officer_credentials/{nip} {
      // Allow single-document lookup by exact NIP for mandatory Cloud PIN verification (including fresh install).
      // Collection-wide `list` remains strictly blocked for unauthenticated callers to prevent enumeration.
      allow get: if isValidId(nip);
      allow list: if isSignedIn();
      allow create: if isValidId(nip)
                    && incoming().keys().hasAll(['nip', 'ownerUid', 'fullName', 'pinHash', 'salt'])
                    && incoming().keys().hasOnly([
                         'nip', 'ownerUid', 'fullName', 'role', 'unit', 'shift', 'phone',
                         'pinHash', 'salt', 'isCustomPinSet', 'isPinChanged',
                         'initialSecurePin', 'lastLoginAt', 'lastLoginDevice', 'updatedAt'
                       ])
                    && isValidOfficerCredential(incoming())
                    && incoming().nip == nip
                    && (
                         (isSignedIn() && (incoming().ownerUid == request.auth.uid || incoming().ownerUid == ('officer_nip_' + nip)))
                         || (!isSignedIn() && incoming().ownerUid == ('officer_nip_' + nip))
                       );
      allow update: if isValidId(nip)
                    && isValidOfficerCredential(incoming())
                    && incoming().nip == nip
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                         'ownerUid', 'fullName', 'role', 'unit', 'shift', 'phone',
                         'pinHash', 'salt', 'isCustomPinSet', 'isPinChanged',
                         'initialSecurePin', 'lastLoginAt', 'lastLoginDevice', 'updatedAt'
                       ])
                    && (
                         (isSignedIn() && existing().ownerUid == request.auth.uid && incoming().ownerUid == existing().ownerUid)
                         || (existing().ownerUid == ('officer_nip_' + nip) && incoming().ownerUid == existing().ownerUid)
                         || (!('ownerUid' in existing()) && incoming().ownerUid == ('officer_nip_' + nip))
                         || (
                              incoming().ownerUid == existing().ownerUid
                              && (!('pinHash' in existing()) || existing().pinHash == '' || !('salt' in existing()) || existing().salt == '')
                            )
                         || (
                              // Allow officer or Admin to update PIN hash & salt while preserving existing ownerUid
                              incoming().ownerUid == existing().ownerUid
                              && incoming().pinHash != ''
                              && incoming().salt != ''
                              && incoming().initialSecurePin == ''
                            )
                         || (
                              incoming().ownerUid == existing().ownerUid
                              && incoming().pinHash == existing().pinHash
                              && incoming().salt == existing().salt
                              && incoming().isCustomPinSet == (('isCustomPinSet' in existing()) ? existing().isCustomPinSet : false)
                              && incoming().isPinChanged == (('isPinChanged' in existing()) ? existing().isPinChanged : (('isCustomPinSet' in existing()) ? existing().isCustomPinSet : false))
                              && incoming().diff(existing()).affectedKeys().hasOnly([
                                   'fullName', 'role', 'unit', 'shift', 'phone',
                                   'isPinChanged', 'initialSecurePin', 'lastLoginAt', 'lastLoginDevice', 'updatedAt'
                                 ])
                            )
                       );
      allow delete: if false;
    }

    // 6. Cloud Disaster Reports Database Backups (User-scoped)
    match /database_backups/{backupId} {
      allow get: if isSignedIn() && isValidId(backupId) && existing().ownerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(backupId)
                    && incoming().ownerUid == request.auth.uid
                    && incoming().keys().hasAll(['backupId', 'ownerUid', 'backupDate', 'officerName'])
                    && incoming().keys().hasOnly(['backupId', 'ownerUid', 'backupDate', 'officerName', 'totalReports', 'reports'])
                    && isValidDatabaseBackup(incoming());
      allow update: if isSignedIn()
                    && isValidId(backupId)
                    && isValidDatabaseBackup(incoming())
                    && existing().ownerUid == request.auth.uid
                    && incoming().ownerUid == existing().ownerUid
                    && incoming().diff(existing()).affectedKeys().hasOnly(['backupId', 'backupDate', 'officerName', 'totalReports', 'reports']);
      allow delete: if false;
    }

    // 7. Multi-Device Heartbeats for Real-Time Sync
    match /device_heartbeats/{deviceId} {
      allow read: if true;
      allow create, update: if isValidId(deviceId)
                    && incoming().keys().hasAll(['deviceId', 'ownerUid', 'status'])
                    && incoming().keys().hasOnly(['deviceId', 'ownerUid', 'deviceModel', 'officerName', 'lastSeen', 'latencyMs', 'status'])
                    && isValidDeviceHeartbeat(incoming());
      allow delete: if isValidId(deviceId);
    }

    // 8. Network Latency Pings
    match /network_pings/{deviceId} {
      allow read: if true;
      allow create, update: if isValidId(deviceId)
                    && incoming().keys().hasAll(['deviceId', 'ownerUid', 'pingTimestamp'])
                    && incoming().keys().hasOnly(['deviceId', 'ownerUid', 'pingTimestamp'])
                    && isValidNetworkPing(incoming());
      allow delete: if isValidId(deviceId);
    }

    // 9. Play Integrity Classic Device Security Sessions (Ruang Kerja Access Gating)
    match /device_security_sessions/{officerNip} {
      allow get: if isValidId(officerNip);
      allow list: if isSignedIn();
      allow create, update: if isValidId(officerNip)
                    && incoming().keys().hasAll(['sessionId', 'ownerUid', 'officerNip', 'accessGranted', 'timestamp'])
                    && incoming().keys().hasOnly([
                         'sessionId', 'ownerUid', 'nip', 'officerNip', 'officerName', 'officerRole',
                         'integrityToken', 'tokenHash', 'tokenLength', 'tokenSource', 'classicNonce',
                         'verdict', 'deviceVerdict', 'deviceId', 'deviceModel', 'deviceBrand',
                         'deviceManufacturer', 'deviceHardware', 'deviceFingerprintHash', 'isEmulator',
                         'osVersion', 'sdkInt', 'appVersion', 'loginMethod', 'loginStatus',
                         'loginAction', 'loginCount', 'lastActivityDetail',
                         'isVerified', 'accessGranted', 'adminVerified', 'adminVerifiedBy',
                         'adminVerifiedAt', 'adminVerificationNote', 'targetModule', 'timestamp',
                         'device_name', 'os_version', 'login_time', 'is_active'
                       ])
                    && isValidDeviceSecuritySession(incoming());
      allow delete: if isValidId(officerNip)
                    && (
                         (isSignedIn() && existing().ownerUid == request.auth.uid)
                         || (!isSignedIn() && (existing().ownerUid == officerNip || existing().ownerUid == ('officer_nip_' + officerNip)))
                       );
    }

    // 9b. Firestore-Backed Officer Sessions (Session Management replacing Play Integrity)
    match /officer_sessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if isValidId(sessionId)
                    && incoming().keys().hasAll(['nip', 'device_name', 'os_version', 'login_time', 'is_active'])
                    && isValidOfficerSession(incoming());
      allow delete: if isValidId(sessionId);
    }

    // 10. Play Integrity Security Audit & Validation Failures Logging (Append-Only)
    match /device_security_failures/{failureId} {
      allow get: if isSignedIn() && isValidId(failureId) && existing().ownerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(failureId)
                    && incoming().ownerUid == request.auth.uid
                    && incoming().keys().hasAll(['failureId', 'ownerUid', 'officerNip', 'reason', 'timestamp'])
                    && incoming().keys().hasOnly([
                         'failureId', 'ownerUid', 'officerNip', 'reason',
                         'deviceId', 'deviceModel', 'osVersion', 'sdkInt',
                         'recordedSessionId', 'recordedVerdict', 'recordedTokenHash',
                         'targetModule', 'additionalDetails', 'timestamp'
                       ])
                    && isValidDeviceSecurityFailure(incoming());
      allow update, delete: if false;
    }

    // 11. Cloud Master Admin Configuration & Public Storage Endpoint Discovery
    match /app_settings/{docId} {
      allow get: if isValidId(docId);
      allow create, update: if docId == 'supabase_storage_config'
                    && incoming().keys().hasAll(['supabaseUrl', 'supabaseKey', 'bucketName', 'updatedAt'])
                    && incoming().keys().hasOnly(['supabaseUrl', 'supabaseKey', 'bucketName', 'updatedAt'])
                    && incoming().supabaseUrl is string
                    && incoming().supabaseUrl.size() >= 12
                    && incoming().supabaseUrl.size() <= 256
                    && incoming().supabaseKey is string
                    && incoming().supabaseKey.size() >= 16
                    && incoming().supabaseKey.size() <= 512
                    && incoming().bucketName is string
                    && incoming().bucketName.size() >= 1
                    && incoming().bucketName.size() <= 64
                    && incoming().updatedAt is int;
      allow list, delete: if false;
    }

    // 12. Admin Access Audit Logs (Purgeable for test simulation records)
    match /admin_access_audit_logs/{logId} {
      allow read, create, delete: if isSignedIn() && isValidId(logId);
      allow update: if false;
    }

    // 13. Officer Login Activity & Play Integrity Classic Audit Stream (Append-Only)
    match /device_login_activities/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if true;
      allow create: if isValidId(activityId)
                    && incoming().keys().hasAll([
                         'activityId', 'ownerUid', 'officerNip', 'loginMethod',
                         'loginStatus', 'action', 'timestamp'
                       ])
                    && incoming().keys().hasOnly([
                         'activityId', 'ownerUid', 'sessionId', 'officerNip', 'officerName', 'officerRole',
                         'loginMethod', 'loginStatus', 'action', 'verdict', 'deviceVerdict',
                         'tokenSource', 'tokenHash', 'tokenLength', 'classicNonce',
                         'deviceId', 'deviceModel', 'deviceBrand', 'deviceHardware', 'deviceFingerprintHash',
                         'osVersion', 'sdkInt', 'isEmulator', 'appVersion',
                         'accessGranted', 'detail', 'timestamp'
                       ])
                    && isValidDeviceLoginActivity(incoming())
                    && incoming().activityId == activityId
                    && (
                         (isSignedIn() && incoming().ownerUid == request.auth.uid)
                         || (!isSignedIn() && incoming().ownerUid == ('officer_nip_' + incoming().officerNip))
                       );
      allow update: if false;
      allow delete: if isValidId(activityId)
                    && (
                         (isSignedIn() && existing().ownerUid == request.auth.uid)
                         || (!isSignedIn() && existing().ownerUid == ('officer_nip_' + existing().officerNip))
                       );
    }

    // 14. BPBD Volunteer Registration & Coordination (Offline-First SQLite -> Auto-Sync Cloud Firestore)
    function isValidBpbdVolunteer(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128
          && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
          && data.nik is string && data.nik.size() >= 4 && data.nik.size() <= 32
          && data.phoneNumber is string && data.phoneNumber.size() >= 4 && data.phoneNumber.size() <= 40
          && data.organization is string && data.organization.size() >= 1 && data.organization.size() <= 120
          && data.skillsCsv is string && data.skillsCsv.size() >= 1 && data.skillsCsv.size() <= 500
          && data.status is string && data.status.size() >= 1 && data.status.size() <= 40
          && (!('homeDistrict' in data) || (data.homeDistrict is string && data.homeDistrict.size() <= 100))
          && (!('assignedDistrict' in data) || (data.assignedDistrict is string && data.assignedDistrict.size() <= 100))
          && (!('assignedPoskoName' in data) || (data.assignedPoskoName is string && data.assignedPoskoName.size() <= 200))
          && (!('assignedShift' in data) || (data.assignedShift is string && data.assignedShift.size() <= 120))
          && (!('isActive' in data) || data.isActive is bool)
          && (!('needsAssistance' in data) || data.needsAssistance is bool)
          && (!('assistanceNote' in data) || (data.assistanceNote is string && data.assistanceNote.size() <= 500))
          && (!('selfiePhotoUri' in data) || data.selfiePhotoUri == null || (data.selfiePhotoUri is string && data.selfiePhotoUri.size() <= 400000))
          && (!('certificatePhotoUri' in data) || data.certificatePhotoUri == null || (data.certificatePhotoUri is string && data.certificatePhotoUri.size() <= 400000))
          && (!('waktu_checkin' in data) || data.waktu_checkin == null || data.waktu_checkin is int)
          && (!('waktu_checkout' in data) || data.waktu_checkout == null || data.waktu_checkout is int)
          && (!('suratTugasNumber' in data) || data.suratTugasNumber == null || (data.suratTugasNumber is string && data.suratTugasNumber.size() <= 120))
          && (!('suratTugasPdfPath' in data) || data.suratTugasPdfPath == null || (data.suratTugasPdfPath is string && data.suratTugasPdfPath.size() <= 500))
          && (!('registeredAt' in data) || data.registeredAt is int)
          && (!('updatedAt' in data) || data.updatedAt is int)
          && (!('verifiedByOfficer' in data) || (data.verifiedByOfficer is string && data.verifiedByOfficer.size() <= 150))
          && (!('isSyncedToCloud' in data) || data.isSyncedToCloud is bool);
    }

    match /bpbd_volunteers/{volunteerId} {
      allow read: if true;
      allow create, update: if isValidId(volunteerId)
                    && incoming().keys().hasAll(['id', 'fullName', 'nik', 'phoneNumber', 'organization', 'skillsCsv', 'status'])
                    && isValidBpbdVolunteer(incoming());
      allow delete: if isSignedIn() && isValidId(volunteerId);
    }
  }
}
