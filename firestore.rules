rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Preferences & Notification Settings
    match /users/{userId}/preferences/{prefId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
                    && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // Citizen Community Weather Reports
    match /community_reports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.districtName is string
                    && request.resource.data.weatherCondition is string;
      allow update: if true;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Citizen Disaster Reports (SIPAGAR KITA BPBD Mukomuko)
    match /citizen_disaster_reports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.disasterType is string;
      allow update: if true;
      allow delete: if true;
    }

    // Pusdalops & TRC Official Officers Directory
    match /officers/{officerId} {
      allow read: if true;
      allow write: if true;
    }

    // Cloud Disaster Reports Database Backups
    match /database_backups/{backupId} {
      allow read: if true;
      allow write: if true;
    }

    // Multi-Device Heartbeats & Pings for Real-Time Sync
    match /device_heartbeats/{deviceId} {
      allow read, write: if true;
    }

    match /network_pings/{deviceId} {
      allow read, write: if true;
    }

    // Play Integrity Classic Device Security Sessions (Ruang Kerja Access Gating)
    match /device_security_sessions/{officerNip} {
      allow read, write: if true;
    }

    // Play Integrity Security Audit & Validation Failures Logging
    match /device_security_failures/{failureId} {
      allow read, write: if true;
    }
  }
}
